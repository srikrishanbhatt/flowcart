# Copy to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL. When using docker-compose, the POSTGRES_* values create the
# database user, and DATABASE_URL must use the same credentials.
POSTGRES_USER=flowcart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowcart
DATABASE_URL=postgresql://flowcart:change-me@localhost:5432/flowcart

# Optional: tests use a separate database. Defaults to DATABASE_URL with the
# database name replaced by flowcart_test.
# TEST_DATABASE_URL=postgresql://flowcart:change-me@localhost:5432/flowcart_test

# JWT signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
